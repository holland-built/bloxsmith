# Consumed by goreleaser `dockers_v2:` — the binary is already cross-compiled by
# the `builds:` stage and dropped into the per-platform build context
# (<platform>/bloxsmith), so this is a single COPY into a distroless base
# (no toolchain, no shell, ~2 MB over the binary itself).
#
# Same runtime env contract as the retired python Dockerfile, so the existing
# docker-compose.yml + `noc-vault` volume keep working with zero changes.
# PINNED BY DIGEST, was `:latest` until 2026-08-13. A mutable tag means the base
# can change with no commit in this repo, so two builds of identical source can
# ship different bytes and neither the SBOM attestation nor the release scan
# would have a commit to point at.
#
# This is the multi-arch INDEX digest, not a per-platform one. dockers_v2 builds
# linux/amd64 and linux/arm64 from this same line; a single-platform digest would
# fail one of them outright. Verified 2026-08-13 with
# `docker buildx imagetools inspect`: an OCI image index of 6 manifests including
# linux/amd64 and linux/arm64/v8.
#
# THE HONEST RISK, and why this is safe HERE and not everywhere. Pinning freezes
# the base, which also freezes any security fix the base would otherwise have
# picked up silently — a stale pin is a real exposure, and it is the reason
# pinning is sometimes worse than not pinning. It is safe in this repo only
# because release.yml scans the published image with trivy on every release and
# fails on fixable HIGH/CRITICAL. So a base that goes stale becomes a RED RELEASE
# rather than a quiet one. The pin and that scan are one control; neither is
# complete on its own. Do not remove the scan and keep the pin.
#
# To refresh (do this when the scan goes red, or on a routine sweep):
#   docker buildx imagetools inspect gcr.io/distroless/static:latest | head -3
# and replace the digest below with the `Digest:` line it prints.
FROM gcr.io/distroless/static@sha256:9197324ba51d9cd071af8505989365c006adf9d6d2067eada25aef00abbb5278

ARG TARGETPLATFORM
WORKDIR /app
COPY $TARGETPLATFORM/bloxsmith /app/bloxsmith
# Templates are committed in go/templates and staged into the build context by
# dockers_v2[].extra_files. Matches ENV TEMPLATES_DIR=/templates below.
COPY templates /templates

# The licence notice, and not optional. The binary above contains a derivative
# work of Chris Marrison's BSD-2-Clause uddi_automation_toolkit, and the
# templates just copied follow its schema. Clause 2 of that licence requires a
# binary redistribution to reproduce the copyright notice; every image published
# before this line did not. Staged into the build context by
# dockers_v2[].extra_files, which is only half the job — without this COPY the
# files sit in the context and never reach the image.
#
# /app, beside the binary, rather than /usr/share/doc: this is a distroless
# image with no shell, so the only way anyone reads these is `docker cp` or an
# image inspection tool, and both are easier when it is next to the thing it
# describes.
COPY LICENSE NOTICE.md /app/

# AUDIT_TRUST_DIR IS A SEPARATE PATH FROM VAULT_DIR, AND THAT IS THE WHOLE POINT.
#
# Without it, audit.DefaultTrustDir() resolves to the per-user config directory —
# which in this image is /root/.config/bloxsmith-audit, i.e. the container's
# WRITABLE LAYER. Measured against the published 3.66.6 image: four containers
# started against one persistent /vault volume produced four different key ids.
# The log persists and its signing key does not, so from the first `docker
# compose pull && up -d` onward the chain reports could-not-verify forever — the
# entries carry a key_id no later process holds. The tamper-evidence feature was
# off, by default, on the install path README offers first. See issue #58.
#
# WHY NOT /vault/audit-trust, which would have been one word shorter.
# internal/audit/key.go requires the trust root to be somewhere the log's writer
# cannot reach. A subdirectory of the same mounted volume is not that: one
# backup, one copied volume, one path-traversal bug carries the log AND the key
# that signs it, and an attacker holding both can rewrite the log and re-seal it.
# It would also be SILENT — audit.New only warns when the trust dir IS the log's
# directory, and /vault/audit-trust is not, so it would create exactly the state
# that warning exists to catch without printing it.
#
# WHAT THIS DOES NOT DO. `VOLUME` alone gives an ANONYMOUS volume to anyone who
# does not name one, and a later `docker run` gets a fresh anonymous volume — so
# the key is still lost. docker-compose.yml names it (noc-audit-trust) and
# README's `docker run` line carries the matching -v. The strongest option
# remains AUDIT_KEY from an injected secret, where the key never touches the
# host at all; docs/DEPLOYMENT.md documents both.
ENV HOST=0.0.0.0 \
    PORT=8080 \
    VAULT_DIR=/vault \
    AUDIT_TRUST_DIR=/audit-trust \
    TEMPLATES_DIR=/templates \
    BLOXSMITH_IN_CONTAINER=1

# Encrypted vault volume — carries over from the python image unchanged.
VOLUME /vault
# The audit chain's signing key and sealed head. Separate volume, never a
# subdirectory of /vault — see the ENV comment above.
VOLUME /audit-trust
EXPOSE 8080

ENTRYPOINT ["/app/bloxsmith"]
